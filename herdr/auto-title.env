# Auto Title (kryptamine/herdr-auto-title) settings. install.py symlinks this to
# the file the plugin reads at startup:
#   macOS  ~/Library/Application Support/herdr-auto-title/config.env
#   Linux  ~/.config/herdr-auto-title/config.env
# A change only lands after the plugin restarts, and plugins restart with the
# server: `herdr server stop`, then `herdr` brings the session back.

# The tab bar already numbers tabs and the position is the key that switches to
# them anyway, so "1 · " in front of every title only costs width.
HERDR_AUTO_TITLE_POSITION=false

# The agent's name is on the pane border (show_agent_labels_on_pane_borders), so
# "claude › " in the title said it twice. A pane whose agent has reported nothing
# is named after its directory instead.
HERDR_AUTO_TITLE_AGENT_NAME=false

# The branch is shown on the second row of each agent sidebar entry ($branch in
# ui.sidebar.agents.rows, reported by claude/statusline-command.sh) and under
# the workspace in the Spaces section, so the title does not carry it too.
HERDR_AUTO_TITLE_BRANCH_MAX=0

# A tab with an editor split beside the agent is named after the agent, not
# after whichever pane is focused, so the title stops flipping between
# "nvim › file" and the agent's topic. Added by the prefer-agent-pane patch on
# youngxguo/herdr-auto-title (install.py installs from there); upstream ignores
# the setting until the PR lands.
HERDR_AUTO_TITLE_PREFER_AGENT=true
