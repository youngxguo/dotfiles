font-family = "MesloLGS Nerd Font Mono"
font-size = 16
theme = "solarized_dark"
cursor-style = block
shell-integration-features = no-cursor
custom-shader = ./shaders/cursor-smear-fade.glsl
custom-shader-animation = true
clipboard-paste-protection = false
desktop-notifications = true

# ESC CR is Meta-Enter, which Claude Code reads as a newline.
keybind = alt+enter=text:\x1b\x0d

# \x15 is Ctrl-U, which zsh, fzf, Neovim insert mode and Claude Code read as
# kill to line start.
keybind = super+backspace=text:\x15
