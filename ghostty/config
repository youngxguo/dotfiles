font-family = "MesloLGS Nerd Font Mono"
# Needed for Neovim UI glyphs (Heirline separators/icons, devicons, etc.)
font-size = 16
theme = "solarized_dark"
cursor-style = block
shell-integration-features = no-cursor
custom-shader = ./shaders/cursor-smear-fade.glsl
custom-shader-animation = true
clipboard-paste-protection = false
desktop-notifications = true

# Send Option-Enter as Meta-Enter so tmux can distinguish it from Ctrl-J.
keybind = alt+enter=text:\x1b\x0d

# Cmd-Backspace: delete to the start of the line, like the rest of macOS. Send
# Ctrl-U, which fzf (fzf-lua pickers), zsh, Neovim insert mode and Claude Code
# all read as "kill to line start". Without this Ghostty sends a plain Backspace.
keybind = super+backspace=text:\x15

# Cmd 1-9: jump to the Nth tmux session or Herdr agent chat. Ghostty owns these
# chords by default, so unbind both trigger forms and let the active multiplexer
# receive the real Command-modified key. Herdr binds cmd+1..9 directly; tmux
# recognizes the corresponding Kitty keyboard sequences as user-keys.
# Ghostty's goto_tab default binds BOTH trigger forms for each digit: the physical
# key (super+digit_N) and the translated char (super+N). A Cmd-N press can resolve
# to either, so we MUST override both.
keybind = super+digit_1=unbind
keybind = super+1=unbind
keybind = super+digit_2=unbind
keybind = super+2=unbind
keybind = super+digit_3=unbind
keybind = super+3=unbind
keybind = super+digit_4=unbind
keybind = super+4=unbind
keybind = super+digit_5=unbind
keybind = super+5=unbind
keybind = super+digit_6=unbind
keybind = super+6=unbind
keybind = super+digit_7=unbind
keybind = super+7=unbind
keybind = super+digit_8=unbind
keybind = super+8=unbind
keybind = super+digit_9=unbind
keybind = super+9=unbind
